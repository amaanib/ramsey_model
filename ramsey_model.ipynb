    "ax.set_xlabel(\"Time\", fontsize=11)\n",
    "ax.set_ylabel(r\"Consumption $c$\", fontsize=11)\n",
    "ax.set_title(\"Consumption Growth\", fontsize=12)\n",
    "ax.set_xlim(0, 100)\n",
