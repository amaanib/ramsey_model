    "## 5. Sensitivity Analysis: Effect of $\\sigma$ and $\\rho$\n",
    "\n",
    "How does the optimal initial consumption $c_0$ and the transition speed change as we vary the **elasticity of intertemporal substitution** $\\sigma$ and the **discount rate** $\\rho$?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f8a9b0c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "sigma_vals = [0.2, 0.5, 1.0, 2.0]\n",
    "rho_vals   = [0.02, 0.05, 0.10, 0.15]\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
    "fig.suptitle(r\"Sensitivity Analysis: Effect of $\\sigma$ and $\\rho$ on Optimal $k(t)$\",\n",
    "             fontsize=13, fontweight=\"bold\", y=1.01)\n",
    "\n",
    "palette = [\"#1D4ED8\", \"#16A34A\", \"#D97706\", \"#DC2626\"]\n",
    "\n",
    "# ── Vary sigma ────────────────────────────────────────────────────────────────\n",
    "ax = axes[0]\n",
    "for col, s in zip(palette, sigma_vals):\n",
    "    def sim_sigma(c0):\n",
    "        k_ = np.zeros(N + 1); c_ = np.zeros(N + 1)\n",
    "        k_[0] = k0; c_[0] = c0\n",
    "        for tt in range(N):\n",
    "            k_[tt+1] = k_[tt] + dt * (A*k_[tt] - c_[tt] - (delta+n)*k_[tt])\n",
    "            c_[tt+1] = c_[tt] + dt * s * (A - delta - rho) * c_[tt]\n",
    "        return k_, c_\n",
    "\n",
    "    # Quick bisection for this sigma\n",
    "    cl, ch = 0.01, c_star * 0.95\n",
    "    for _ in range(80):\n",
    "        cm = (cl + ch) / 2\n",
    "        kk, cc = sim_sigma(cm)\n",
    "        if cc[-1] > c_star or kk[-1] > k_star: ch = cm\n",
    "        else: cl = cm\n",
    "    kk, _ = sim_sigma(cm)\n",
    "    ax.plot(t, kk, color=col, linewidth=2, label=rf\"$\\sigma={s}$\")\n",
    "\n",
    "ax.axhline(k_star, color=\"gray\", linestyle=\"--\", alpha=0.5)\n",
    "ax.set_xlim(0, 100); ax.set_xlabel(\"Time\"); ax.set_ylabel(r\"Capital $k$\")\n",
    "ax.set_title(r\"Varying $\\sigma$ (EIS)\"); ax.legend(); ax.grid(True, alpha=0.3)\n",
    "\n",
    "# ── Vary rho ──────────────────────────────────────────────────────────────────\n",
    "ax = axes[1]\n",
    "for col, r in zip(palette, rho_vals):\n",
    "    c_ss = A * k_star - (delta + n) * k_star  # c* unchanged\n",
    "\n",
    "    def sim_rho(c0):\n",
    "        k_ = np.zeros(N + 1); c_ = np.zeros(N + 1)\n",
    "        k_[0] = k0; c_[0] = c0\n",
    "        for tt in range(N):\n",
    "            k_[tt+1] = k_[tt] + dt * (A*k_[tt] - c_[tt] - (delta+n)*k_[tt])\n",
    "            c_[tt+1] = c_[tt] + dt * sigma * (A - delta - r) * c_[tt]\n",
    "        return k_, c_\n",
    "\n",
    "    cl, ch = 0.01, c_ss * 0.95\n",
    "    for _ in range(80):\n",
    "        cm = (cl + ch) / 2\n",
    "        kk, cc = sim_rho(cm)\n",
    "        if cc[-1] > c_ss or kk[-1] > k_star: ch = cm\n",
    "        else: cl = cm\n",
    "    kk, _ = sim_rho(cm)\n",
    "    ax.plot(t, kk, color=col, linewidth=2, label=rf\"$\\rho={r}$\")\n",
    "\n",
    "ax.axhline(k_star, color=\"gray\", linestyle=\"--\", alpha=0.5)\n",
    "ax.set_xlim(0, 100); ax.set_xlabel(\"Time\"); ax.set_ylabel(r\"Capital $k$\")\n",
    "ax.set_title(r\"Varying $\\rho$ (discount rate)\"); ax.legend(); ax.grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"ramsey_sensitivity.png\", dpi=150, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "print(\"Saved: ramsey_sensitivity.png\")"
